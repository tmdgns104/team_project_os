# python -c "import secrets; print(secrets.token_urlsafe(32))" 로 생성하세요.
# production에서는 32자 미만/예시 문자열이면 서버가 기동되지 않습니다.
APP_ACCESS_KEY=replace-with-a-random-key-at-least-32-characters

# 실제 접속 도메인/IP를 쉼표로 구분합니다. 와일드카드는 production에서 금지됩니다.
PROJECT_OS_ALLOWED_HOSTS=localhost,127.0.0.1

# production 기본값은 0입니다. 명시적으로 데모가 필요할 때만 1로 변경하세요.
PROJECT_OS_SEED_DEMO=0

# 앱 레벨 Content-Length 제한. Reverse Proxy에도 별도 본문 제한을 설정하세요.
PROJECT_OS_MAX_REQUEST_BYTES=2000000
